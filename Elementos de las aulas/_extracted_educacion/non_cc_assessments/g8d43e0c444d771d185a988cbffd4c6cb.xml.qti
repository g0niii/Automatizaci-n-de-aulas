      <item ident="b2d6dd486b5a939fa0d68d1ad533d4de" title="PREGUNTA 2">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>48f71459-3097-40fb-9adb-d501b58e0c8d,7b09e68b-696a-4919-af50-5bd8d3bcb7a1,ebd162e3-948d-40f8-b114-2724dc959488,8b70b0a0-ac28-4dc1-b871-748c7d83a85b</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>e41f09c15fba9d2e2ab359cfc40de773</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;&#xBF;C&#xF3;mo evaluar&#xED;as la claridad y significatividad de las actividades propuestas durante tu proceso de aprendizaje?&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="48f71459-3097-40fb-9adb-d501b58e0c8d">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;Fueron significativas &lt;/strong&gt;&lt;span style="font-weight: 400;"&gt;y me ayudaron a comprender mejor la asignatura y a organizar mis tiempos de cursado&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="7b09e68b-696a-4919-af50-5bd8d3bcb7a1">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;Fueron &#xFA;tiles&lt;/strong&gt;&lt;span style="font-weight: 400;"&gt;, aunque podr&#xED;an haber sido m&#xE1;s frecuentes o con mayor nivel de detalle&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="ebd162e3-948d-40f8-b114-2724dc959488">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;No estoy seguro/a&lt;/strong&gt;&lt;span style="font-weight: 400;"&gt;, ya que percib&#xED; cierta falta de orientaci&#xF3;n o claridad en las consignas.&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="8b70b0a0-ac28-4dc1-b871-748c7d83a85b">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;No fueron &#xFA;tiles&lt;/strong&gt;&lt;span style="font-weight: 400;"&gt; y me sent&#xED; desorientado/a durante el cursado&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">48f71459-3097-40fb-9adb-d501b58e0c8d</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="101f9a6bc64d71590f364724330b4ff7" title="PREGUNTA 3">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>d708ba81-568e-49ad-992f-f679b96fa34f,2508dc3e-02da-4141-ba6b-a23d113c7e73,b919c05e-9c25-4a5f-bfa3-76fff052bc33,c843bb17-0710-4294-9c13-02e695abaec8</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>9adcff6306a86c9192094bfaec4ca65c</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;&#xBF;C&#xF3;mo evaluar&#xED;as la calidad de las devoluciones e intervenciones de tu docente tutor/a ( actividades evaluativas, foros, mensajer&#xED;a interna, anuncios y espacios sincr&#xF3;nicos optativos,) durante tu proceso de aprendizaje?&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="d708ba81-568e-49ad-992f-f679b96fa34f">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;Excelente&lt;/strong&gt;&lt;span style="font-weight: 400;"&gt;, las devoluciones fueron claras, espec&#xED;ficas y me proporcionaron informaci&#xF3;n valiosa para identificar mis fortalezas y posibilidades de mejora.&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="2508dc3e-02da-4141-ba6b-a23d113c7e73">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;Muy bueno&lt;/strong&gt;&lt;span style="font-weight: 400;"&gt;, las devoluciones fueron&amp;nbsp; claras y pertinentes. &lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="b919c05e-9c25-4a5f-bfa3-76fff052bc33">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;Aceptable&lt;/strong&gt;&lt;span style="font-weight: 400;"&gt;, las devoluciones fueron adecuadas, pero poco personalizadas y con comentarios generales que no profundizan en aspectos espec&#xED;ficos de mis presentaciones.&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="c843bb17-0710-4294-9c13-02e695abaec8">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;Insuficiente&lt;/strong&gt;&lt;span style="font-weight: 400;"&gt;, las devoluciones fueron m&#xED;nimas y carecen de detalles que me gu&#xED;en de manera significativa en el aprendizaje.&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">d708ba81-568e-49ad-992f-f679b96fa34f</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
      <item ident="329b38e5ef3e1a6edc007e1e1c4d73c5" title="PREGUNTA  4">
        <itemmetadata>
          <qtimetadata>
            <qtimetadatafield>
              <fieldlabel>question_type</fieldlabel>
              <fieldentry>multiple_choice_question</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>points_possible</fieldlabel>
              <fieldentry>1.0</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>original_answer_ids</fieldlabel>
              <fieldentry>9f7d0256-fb01-4cc7-8d40-7aeb9ba13323,6506dd27-7615-4259-b05f-feabb29d716a,e31b7ecd-6837-447d-86bf-214beed6cda2,c50410d9-d1b2-424a-a0ab-e0aaaf9e9924</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>assessment_question_identifierref</fieldlabel>
              <fieldentry>f9931cb8af4f668cb725d96ed0de24e1</fieldentry>
            </qtimetadatafield>
            <qtimetadatafield>
              <fieldlabel>calculator_type</fieldlabel>
              <fieldentry>none</fieldentry>
            </qtimetadatafield>
          </qtimetadata>
        </itemmetadata>
        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;&#xBF;C&#xF3;mo evaluar&#xED;as la organizaci&#xF3;n de la propuesta de cursado de la asignatura en relaci&#xF3;n con la distribuci&#xF3;n del tiempo para las lecturas y la realizaci&#xF3;n de actividades?&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Single">
            <render_choice>
              <response_label ident="9f7d0256-fb01-4cc7-8d40-7aeb9ba13323">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;Muy conforme&lt;span style="font-weight: 400;"&gt;: La distribuci&#xF3;n del tiempo fue excelente y me permiti&#xF3; cumplir con todas las lecturas y actividades sin problemas.&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="6506dd27-7615-4259-b05f-feabb29d716a">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;Conforme&lt;span style="font-weight: 400;"&gt;: La organizaci&#xF3;n fue buena, aunque hubo momentos en que me sent&#xED; un poco ajustado con el tiempo.&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="e31b7ecd-6837-447d-86bf-214beed6cda2">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;Poco conforme&lt;span style="font-weight: 400;"&gt;: La distribuci&#xF3;n del tiempo fue insatisfactoria; me cost&#xF3; organizarme para completar las lecturas y actividades.&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="c50410d9-d1b2-424a-a0ab-e0aaaf9e9924">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;strong&gt;Nada conforme&lt;/strong&gt;&lt;span style="font-weight: 400;"&gt;: La organizaci&#xF3;n del tiempo fue deficiente y me impidi&#xF3; cumplir con las lecturas y actividades de manera efectiva.&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
        <resprocessing>
          <outcomes>
            <decvar maxvalue="100" minvalue="0" varname="SCORE" vartype="Decimal"/>
          </outcomes>
          <respcondition continue="No">
            <conditionvar>
              <varequal respident="response1">9f7d0256-fb01-4cc7-8d40-7aeb9ba13323</varequal>
            </conditionvar>
            <setvar action="Set" varname="SCORE">100</setvar>
          </respcondition>
        </resprocessing>
      </item>
