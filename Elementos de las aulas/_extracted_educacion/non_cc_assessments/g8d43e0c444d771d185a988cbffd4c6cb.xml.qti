        <presentation>
          <material>
            <mattext texttype="text/html">&lt;p&gt;Del material consultado en la plataforma &#xBF;Cu&#xE1;les te resultaron m&#xE1;s significativos en tu experiencia de aprendizaje? &lt;span style="font-weight: 400;"&gt;(Marca todos los que correspondan)&lt;/span&gt;&lt;/p&gt;</mattext>
          </material>
          <response_lid ident="response1" rcardinality="Multiple">
            <render_choice>
              <response_label ident="ca489a1c-c1f4-4ea9-87fd-f317f8f28e3e">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Material de lectura&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="0dcf1a1a-a4d4-48f6-ac56-e26b8456d130">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;Videos&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="9d9ad87b-302f-40f3-9d83-0eaef5f6586e">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-weight: 400;"&gt;Audio y/o Podcast&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="8bb522e4-fa91-4e91-8d7f-be8b886935de">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-weight: 400;"&gt;Materiales interactivos (como genially, padlet)&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="c13d8d66-9f92-44a5-a09e-50b85ed4452c">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-weight: 400;"&gt;Presentaciones visuales (como infograf&#xED;as, im&#xE1;genes)&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="d1aaee5a-b194-4e38-854c-87f588850884">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-weight: 400;"&gt;Todos&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
              <response_label ident="4a4229ab-1d03-4a16-bb70-01836dbd84bc">
                <material>
                  <mattext texttype="text/html">&lt;p&gt;&lt;span style="font-weight: 400;"&gt;Ninguno&lt;/span&gt;&lt;/p&gt;</mattext>
                </material>
              </response_label>
            </render_choice>
          </response_lid>
        </presentation>
